# ==============================================
# CONFIGURACIÓN DE PRODUCCIÓN - DOCKER
# ==============================================

# PostgreSQL Database
POSTGRES_USERNAME=zaza
POSTGRES_PASSWORD=1234
POSTGRES_DATABASE=evolution_api

# Evolution API Configuration
# NOTA: API Key limitada a 10 caracteres por restricción de Appwrite
EVOLUTION_API_KEY=EvoAPI2024
# Para desarrollo local
# EVOLUTION_SERVER_URL=http://localhost:8081
# Para producción con Nginx (cambiar tu-dominio.com por tu dominio real)
EVOLUTION_SERVER_URL=https://api.agentedecargaonline.com/whatsapp-api

# Webhook Configuration (opcional)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=

# N8N Configuration
# Para desarrollo local
# N8N_EDITOR_BASE_URL=http://localhost:5678
# N8N_PUBLIC_URL=http://localhost:5678
# N8N_WEBHOOK_URL=http://localhost:5678
# Para producción con Nginx
N8N_EDITOR_BASE_URL=https://api.agentedecargaonline.com/whatsapp-n8n
N8N_PUBLIC_URL=https://api.agentedecargaonline.com/whatsapp-n8n
N8N_WEBHOOK_URL=https://tu-dominio.com/whatsapp-webhook

# Appwrite Configuration (Frontend)
VITE_APPWRITE_WHATSAPP_COLLECTION_ID=whatsapp_accounts
VITE_APPWRITE_DATABASE_ID=68e04a01000dcda6e6cb
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=68e0498c003576d90735

# Webhook URL para el frontend
# Para desarrollo local
# VITE_WEBHOOK_URL=http://localhost:5678/webhook/whatsappsms
# Para producción con Nginx
VITE_WEBHOOK_URL=https://api.agentedecargaonline.com/whatsapp-webhook/whatsappsms

# Webhook URL para instancias de Evolution API (interno Docker)
VITE_BOTACO_WEBHOOK_URL=http://n8n:5678/webhook/botaco
