# ==============================================
# CONFIGURACIÓN DE PRODUCCIÓN - DOCKER
# ==============================================

# ==============================================
# COMUNICACIÓN INTERNA DOCKER
# Estas variables usan nombres de servicio Docker para comunicación
# entre contenedores dentro de la red app_network
# ==============================================

# PostgreSQL Database (Comunicación Interna)
# Usado por Evolution API para conectarse a PostgreSQL dentro de Docker
# Formato: postgresql://user:pass@postgres:5432/db
# IMPORTANTE: Usar "postgres" (nombre del servicio) NO "localhost"
POSTGRES_USERNAME=zaza
POSTGRES_PASSWORD=1234
POSTGRES_DATABASE=evolution_api

# Redis Cache (Comunicación Interna)
# Usado por Evolution API para conectarse a Redis dentro de Docker
# Formato: redis://redis:6379/6
# IMPORTANTE: Usar "redis" (nombre del servicio) NO "localhost"
# Configurado en docker-compose.prod.yml: CACHE_REDIS_URI=redis://redis:6379/6

# Webhook URL para instancias de Evolution API (Comunicación Interna Docker)
# Esta URL es usada por Evolution API para enviar webhooks a n8n DENTRO de Docker
# Formato: http://n8n:5678/webhook/botaco
# IMPORTANTE: Usar "n8n" (nombre del servicio) NO "localhost" o dominio público
# Esto evita problemas de CORS y mejora la seguridad
VITE_BOTACO_WEBHOOK_URL=http://n8n:5678/webhook/botaco

# ==============================================
# COMUNICACIÓN EXTERNA (URLs PÚBLICAS)
# Estas variables usan URLs públicas para acceso desde fuera de Docker
# (ej: desde el frontend en Netlify o desde el navegador)
# ==============================================

# Evolution API Configuration (Comunicación Externa)
# NOTA: API Key limitada a 10 caracteres por restricción de Appwrite
EVOLUTION_API_KEY=EvoAPI2024
# URL pública para acceder a Evolution API desde el frontend en Netlify
# Para desarrollo local: http://localhost:8081
# Para producción con Nginx: https://tu-dominio.com/whatsapp-api
EVOLUTION_SERVER_URL=https://tu-dominio.com/whatsapp-api

# Webhook Configuration (opcional)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=

# N8N Configuration (Comunicación Externa)
# URLs públicas para acceder a n8n desde el navegador
# Para desarrollo local:
# N8N_EDITOR_BASE_URL=http://localhost:5678
# N8N_PUBLIC_URL=http://localhost:5678
# N8N_WEBHOOK_URL=http://localhost:5678
# Para producción con Nginx:
N8N_EDITOR_BASE_URL=https://tu-dominio.com/whatsapp-n8n
N8N_PUBLIC_URL=https://tu-dominio.com/whatsapp-n8n
N8N_WEBHOOK_URL=https://tu-dominio.com/whatsapp-webhook

# Appwrite Configuration (Frontend - Comunicación Externa)
# Estas variables son usadas por el frontend para conectarse a Appwrite
VITE_APPWRITE_WHATSAPP_COLLECTION_ID=whatsapp_accounts
VITE_APPWRITE_DATABASE_ID=68e04a01000dcda6e6cb
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=68e0498c003576d90735

# Webhook URL para el frontend (Comunicación Externa)
# URL pública usada por el frontend para configurar webhooks
# Para desarrollo local: http://localhost:5678/webhook/whatsappsms
# Para producción con Nginx: https://tu-dominio.com/whatsapp-webhook/whatsappsms
VITE_WEBHOOK_URL=https://tu-dominio.com/whatsapp-webhook/whatsappsms
